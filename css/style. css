 /* ===========================
   Yalla Nanhad
=========================== */

:root{

--primary:#0F6B4B;
--primary-light:#2FAE66;
--secondary:#F5C542;

--dark:#1D1D1D;

--white:#ffffff;

--bg:#F5F7FA;

--border:#E8E8E8;

--radius:18px;

--shadow:0 10px 30px rgba(0,0,0,.08);

--transition:.3s;

}

*{

margin:0;

padding:0;

box-sizing:border-box;

}

body{

font-family:'IBM Plex Sans Arabic',sans-serif;

background:var(--bg);

color:var(--dark);

overflow-x:hidden;

}

h1,h2,h3,h4,h5{

font-family:'Cairo',sans-serif;

font-weight:700;

}

a{

text-decoration:none;

}

/* ===========================
Header
=========================== */

.main-header{

position:fixed;

top:0;

right:0;

left:0;

z-index:999;

background:#fff;

box-shadow:0 4px 20px rgba(0,0,0,.05);

}

.navbar{

padding:15px 0;

}

.logo{

display:flex;

align-items:center;

gap:12px;

font-size:24px;

font-weight:800;

color:var(--primary);

}

.logo img{

width:45px;

height:45px;

border-radius:50%;

}

.nav-link{

font-weight:600;

margin:0 8px;

color:#444;

transition:.3s;

}

.nav-link:hover{

color:var(--primary);

}

.header-buttons{

display:flex;

align-items:center;

gap:10px;

}

.search-btn,

.dark-btn{

width:45px;

height:45px;

border:none;

border-radius:50%;

background:#F2F4F7;

font-size:18px;

cursor:pointer;

transition:.3s;

}

.search-btn:hover,

.dark-btn:hover{

background:var(--primary);

color:#fff;

}

.login-btn{

padding:10px 22px;

border-radius:30px;

background:var(--primary);

color:#fff;

font-weight:700;

transition:.3s;

}

.login-btn:hover{

background:var(--primary-light);

}

/* ===========================
Hero
=========================== */

.hero{

padding-top:170px;

padding-bottom:90px;

}

.hero h1{

font-size:58px;

line-height:1.4;

margin-bottom:25px;

}

.hero h1 span{

color:var(--primary);

}

.hero p{

font-size:20px;

line-height:2;

margin-bottom:35px;

color:#666;

}

.hero-buttons{

display:flex;

gap:15px;

margin-bottom:35px;

}

.btn-read{

background:var(--primary);

color:#fff;

padding:15px 35px;

border-radius:50px;

font-weight:bold;

}

.btn-podcast{

background:#fff;

color:var(--dark);

padding:15px 35px;

border-radius:50px;

box-shadow:var(--shadow);

}

.search-box{

display:flex;

background:#fff;

border-radius:50px;

padding:8px;

box-shadow:var(--shadow);

max-width:600px;

}

.search-box input{

flex:1;

border:none;

outline:none;

padding:15px;

font-size:17px;

background:none;

}

.search-box button{

width:60px;

border:none;

border-radius:50%;

background:var(--primary);

color:#fff;

font-size:20px;

cursor:pointer;

}

.hero-image{

width:100%;

animation:float 4s ease-in-out infinite;

}

/* ===========================
Bottom Navigation
=========================== */

.bottom-nav{

display:none;

}

/* ===========================
Animation
=========================== */

@keyframes float{

0%{

transform:translateY(0);

}

50%{

transform:translateY(-12px);

}

100%{

transform:translateY(0);

}

}

/* ===========================
Responsive
=========================== */

@media(max-width:991px){

.hero{

text-align:center;

}

.hero h1{

font-size:38px;

}

.hero-buttons{

justify-content:center;

flex-wrap:wrap;

}

.search-box{

margin:auto;

}

.hero-image{

margin-top:40px;

}

.bottom-nav{

position:fixed;

bottom:0;

right:0;

left:0;

display:flex;

justify-content:space-around;

background:#fff;

padding:12px;

box-shadow:0 -5px 20px rgba(0,0,0,.08);

z-index:999;

}

.bottom-nav a{

display:flex;

flex-direction:column;

align-items:center;

font-size:13px;

color:#666;

}

.bottom-nav i{

font-size:22px;

margin-bottom:5px;

color:var(--primary);

}

body{

padding-bottom:90px;

}

}
